<view class="page-wrap page-pad"><rh-load-more wx:if="{{loading}}" loading /><rh-empty wx:if="{{!loading && items.length === 0}}" text="暂无消息" /><view class="message" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="markRead"><rh-card><rh-section-title title="{{item.title}}" /><view class="rh-form-value">{{item.content}}</view><rh-info-row label="状态" value="{{item.is_read ? '已读' : '未读'}}" /><rh-info-row label="时间" value="{{item.created_at}}" /></rh-card></view></view>
