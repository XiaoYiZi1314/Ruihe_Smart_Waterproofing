page {
  background: linear-gradient(180deg, #2B7BE4 0%, #1A5CFF 60%, #F4F6FA 100%);
}

.login-container {
  min-height: 100vh;
  padding: 160rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-header {
  text-align: center;
  margin-bottom: 160rpx;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.login-form {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(26, 92, 255, 0.15);
}

.btn-wx-login {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #2B7BE4 0%, #1A5CFF 100%);
  color: #ffffff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.btn-wx-login[disabled] {
  opacity: 0.7;
  color: #ffffff;
}

.login-tip {
  margin-top: 32rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.login-tip text {
  font-size: 24rpx;
  color: #9CA3AF;
}

.login-footer {
  margin-top: auto;
  padding-top: 48rpx;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 手机号密码登录表单 */
.input-group {
  margin-bottom: 24rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F4F6FA;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #1F2937;
  box-sizing: border-box;
}

.mode-switch {
  margin-top: 24rpx;
  text-align: center;
}

.mode-switch text {
  font-size: 26rpx;
  color: #2B7BE4;
}
