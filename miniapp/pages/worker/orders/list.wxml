<view class="page-wrap page-pad page-wrap--footer">
  <rh-tag-bar items="{{tabs}}" active-key="{{activeTab}}" bind:change="onTabChange" />
  <view class="worker-order" wx:for="{{orders}}" wx:key="id">
    <rh-card>
      <view class="worker-order__top">
        <text class="worker-order__no">工单号：{{item.order_no}}</text>
        <rh-status-tag status="{{item.statusClass}}" text="{{item.statusText}}" />
      </view>
      <rh-info-row label="服务" value="{{item.service_name}}" />
      <rh-info-row label="联系人" value="{{item.contact_name}}" />
      <rh-info-row label="地址" value="{{item.full_address}}" />
      <rh-info-row label="最终价格" value="{{item.priceText}}" />
      <view class="worker-actions">
        <rh-button wx:if="{{item.canCall}}" variant="line" text="拨打电话" data-phone="{{item.contact_phone}}" bind:tap="callCustomer" />
        <rh-button text="工单详情" data-id="{{item.id}}" bind:tap="goToDetail" />
      </view>
    </rh-card>
  </view>
  <rh-empty wx:if="{{!loading && loadFailed && orders.length === 0}}" text="网络不佳，加载失败" action-text="重新加载" bind:action="onRetryLoad" />
  <rh-empty wx:elif="{{!loading && orders.length === 0}}" text="暂无工单" />
  <rh-load-more loading="{{loading || loadingMore}}" finished="{{!hasMore}}" />
  <rh-worker-tabbar active="orders" bind:change="onWorkerNav" />
</view>
