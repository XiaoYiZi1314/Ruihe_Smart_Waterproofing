<view class="page-wrap page-pad">
  <rh-section-title title="{{userInfo.nickname || '师傅个人中心'}}" />
  <view wx:if="{{userInfo && !userInfo.must_change_password}}" class="worker-head">
    <rh-image wx:if="{{userInfo.avatar_url}}" class="worker-head__avatar" src="{{userInfo.avatar_url}}" />
    <view wx:else class="worker-head__avatar worker-head__avatar--placeholder">
      <rh-icon name="user" tone="white" size="48" />
    </view>
    <view class="worker-head__name">头像</view>
    <view><rh-button variant="line" size="sm" text="修改头像" bind:tap="goEditProfile" /></view>
  </view>
  <rh-info-row label="手机号" value="{{userInfo.phone}}" />
  <rh-info-row label="微信" value="{{userInfo.wechat_bound ? '已绑定' : '未绑定'}}" />
  <view class="section"><rh-section-title title="{{userInfo.must_change_password ? '首次登录修改密码' : '修改密码'}}" /></view>
  <rh-form-field label="原密码" required><input class="rh-input" password value="{{currentPassword}}" bindinput="onCurrentPassword" /></rh-form-field>
  <rh-form-field label="新密码" required><input class="rh-input" password placeholder="至少12位，包含字母和数字" value="{{newPassword}}" bindinput="onNewPassword" /></rh-form-field>
  <view class="section"><rh-button text="修改密码" loading="{{submitting}}" bind:tap="changePassword" /></view>
  <block wx:if="{{!userInfo.must_change_password}}">
    <view class="actions"><rh-button wx:if="{{!userInfo.wechat_bound}}" variant="line" text="绑定微信" bind:tap="bindWechat" /><rh-button variant="line" text="订阅通知" bind:tap="subscribe" /><rh-button variant="line" text="站内消息" bind:tap="goMessages" /></view>
    <view class="section"><rh-section-title title="我的业绩" /></view>
    <rh-info-row label="工作状态" value="{{stats.worker_status === 'working' ? '上班中' : '休息中'}}" />
    <rh-info-row label="本月完成" value="{{stats.month_completed}}" />
    <rh-info-row label="累计完成" value="{{stats.total_completed}}" />
    <rh-info-row label="拒单率" value="{{stats.reject_rate}}%" />
    <view class="actions"><rh-button variant="line" text="{{stats.worker_status === 'working' ? '切换休息' : '切换上班'}}" bind:tap="toggleStatus" loading="{{submitting}}" /><rh-button text="工单工作台" bind:tap="goOrders" /></view>
  </block>
  <view class="section"><rh-button variant="ghost" text="退出登录" bind:tap="handleLogout" /></view>
</view>
