.detail-banner {
  height: 400rpx;
  position: relative;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-indicator {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 28rpx;
}

.detail-price {
  font-size: 40rpx;
  color: var(--color-red);
  font-weight: 700;
  margin: 28rpx 32rpx 8rpx;
}

.detail-price__unit {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-weight: 400;
  margin-left: 8rpx;
}

.detail-sec {
  padding: 24rpx 32rpx;
}

.detail-p {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.detail-richtext {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.detail-tags {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.detail-tags text {
  font-size: 22rpx;
  background: var(--color-brand-soft);
  color: var(--color-brand);
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
}