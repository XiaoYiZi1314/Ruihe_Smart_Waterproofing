.book-title {
  font-size: 34rpx;
  font-weight: 600;
  padding: 32rpx 32rpx 8rpx;
}

.price-row {
  display: flex;
  align-items: center;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item,
.image-add {
  width: 148rpx;
  height: 148rpx;
  border-radius: var(--radius-md);
  position: relative;
  overflow: hidden;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  text-align: center;
  line-height: 32rpx;
  font-size: 28rpx;
}

.image-add {
  background: var(--color-input-bg);
  border: 1rpx dashed var(--color-input-border);
  color: var(--color-text-muted);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  gap: 6rpx;
}