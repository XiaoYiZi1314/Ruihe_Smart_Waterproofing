.page {
  padding: 24rpx;
}

/* 工作状态卡片 */
.status-card {
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #ffffff;
}

.status-card--working {
  background: linear-gradient(135deg, #2B7BE4 0%, #1A5CFF 100%);
}

.status-card--resting {
  background: linear-gradient(135deg, #6B7280 0%, #4B5563 100%);
}

.status-card__info {
  display: flex;
  align-items: center;
  flex: 1;
}

.status-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #34D399;
  margin-right: 20rpx;
  box-shadow: 0 0 16rpx rgba(52, 211, 153, 0.8);
}

.status-card--resting .status-dot {
  background: #FBBF24;
  box-shadow: 0 0 16rpx rgba(251, 191, 36, 0.8);
}

.status-text-wrap {
  display: flex;
  flex-direction: column;
}

.status-text {
  font-size: 34rpx;
  font-weight: bold;
}

.status-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.btn-toggle {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 32rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  line-height: 64rpx;
  margin: 0;
  flex-shrink: 0;
}

.btn-toggle[disabled] {
  opacity: 0.7;
  color: #ffffff;
}

/* 统计卡片 */
.stats-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stats-card__title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.stats-value--warn {
  color: #EF4444;
}

.stats-label {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 提示卡片 */
.tip-card {
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #D97706;
  margin-bottom: 8rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #92400E;
  line-height: 1.6;
}

/* 退出登录 */
.btn-logout {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  color: #EF4444;
  border: 2rpx solid #FECACA;
  border-radius: 44rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
