.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.login-content {
  width: 100%;
  padding: 60rpx 60rpx 120rpx;
  position: relative;
  z-index: 10;
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 120rpx;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 40rpx;
  background: linear-gradient(135deg, #38BDF8 0%, #22D3EE 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(56, 189, 248, 0.3);
}

.logo-icon .icon {
  font-size: 80rpx;
}

.app-name {
  display: block;
  font-size: 52rpx;
  font-weight: 600;
  color: #F8FAFC;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.app-slogan {
  display: block;
  font-size: 28rpx;
  color: #94A3B8;
  letter-spacing: 4rpx;
}

/* 登录按钮区域 */
.login-section {
  margin-top: 80rpx;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #38BDF8 0%, #22D3EE 100%);
  color: #0F172A;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(56, 189, 248, 0.4);
  transition: all 0.3s ease;
}

.login-btn::after {
  border: none;
}

.login-btn.loading {
  opacity: 0.7;
}

.login-tips {
  text-align: center;
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.6;
}

.login-tips .link {
  color: #38BDF8;
}

/* 装饰元素 */
.decorations {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 1;
}

.circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(56, 189, 248, 0.1);
  border: 2rpx solid rgba(56, 189, 248, 0.2);
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  right: -100rpx;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  bottom: 100rpx;
  left: -80rpx;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  top: 40%;
  right: -60rpx;
}
