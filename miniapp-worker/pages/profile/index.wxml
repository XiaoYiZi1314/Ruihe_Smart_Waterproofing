<view class="page">
  <!-- 工作状态卡片 -->
  <view class="status-card {{stats.worker_status === 'working' ? 'status-card--working' : 'status-card--resting'}}" wx:if="{{stats}}">
    <view class="status-card__info">
      <view class="status-dot"></view>
      <view class="status-text-wrap">
        <text class="status-text">{{stats.worker_status === 'working' ? '上班中' : '休息中'}}</text>
        <text class="status-sub">{{stats.worker_status === 'working' ? '可接收新工单指派' : '暂不接收新工单指派'}}</text>
      </view>
    </view>
    <button class="btn-toggle" bindtap="toggleStatus" loading="{{statusChanging}}" disabled="{{statusChanging}}">
      {{stats.worker_status === 'working' ? '切换休息' : '切换上班'}}
    </button>
  </view>

  <!-- 数据统计 -->
  <view class="stats-card" wx:if="{{stats}}">
    <view class="stats-card__title">我的业绩</view>
    <view class="stats-grid">
      <view class="stats-item">
        <text class="stats-value">{{stats.month_completed}}</text>
        <text class="stats-label">本月完成</text>
      </view>
      <view class="stats-item">
        <text class="stats-value">{{stats.total_completed}}</text>
        <text class="stats-label">累计完成</text>
      </view>
      <view class="stats-item">
        <text class="stats-value">{{stats.assign_count}}</text>
        <text class="stats-label">累计指派</text>
      </view>
      <view class="stats-item">
        <text class="stats-value {{stats.reject_rate > 20 ? 'stats-value--warn' : ''}}">{{stats.reject_rate}}%</text>
        <text class="stats-label">拒单率</text>
      </view>
    </view>
  </view>

  <!-- 提示 -->
  <view class="tip-card">
    <text class="tip-title">温馨提示</text>
    <text class="tip-text">· 拒单率超过 20% 将影响工单指派</text>
    <text class="tip-text">· 指派后 24 小时内未响应的工单将被标记为异常</text>
    <text class="tip-text">· 完工后请及时填写价格，等待客户验收</text>
  </view>

  <!-- 退出登录 -->
  <button class="btn-logout" bindtap="handleLogout">退出登录</button>
</view>
