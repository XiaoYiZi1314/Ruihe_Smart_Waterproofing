.page {
  padding: 24rpx;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #6B7280;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab-item--active {
  background: linear-gradient(135deg, #2B7BE4 0%, #1A5CFF 100%);
  color: #ffffff;
  font-weight: 500;
}

/* 工单卡片 */
.order-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.order-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.order-no {
  font-size: 26rpx;
  color: #6B7280;
  font-family: monospace;
}

/* 状态标签（复用全局样式） */
.order-card__body {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #9CA3AF;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #1F2937;
}

.info-value--address {
  word-break: break-all;
}

.order-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3F4F6;
}

.price-wrap {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-bottom: 4rpx;
}

.price-value {
  font-size: 34rpx;
  font-weight: bold;
  color: #EF4444;
}

.price-value--empty {
  color: #9CA3AF;
  font-size: 28rpx;
  font-weight: normal;
}

.action-wrap {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.btn-call {
  background: #ECFDF5;
  color: #059669;
  border: 1rpx solid #A7F3D0;
  border-radius: 32rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  line-height: 56rpx;
}

.btn-detail {
  background: linear-gradient(135deg, #2B7BE4 0%, #1A5CFF 100%);
  color: #ffffff;
  border: none;
  border-radius: 32rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  line-height: 56rpx;
}

.order-card__time {
  margin-top: 16rpx;
}

.order-card__time text {
  font-size: 22rpx;
  color: #D1D5DB;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx;
}

.load-more text {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 200rpx 48rpx;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* 顶部工作台栏 */
.workbench-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 8rpx;
  background: #ffffff;
}

.workbench-bar__title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1F2937;
}

.workbench-bar__entry {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #2B7BE4;
}

.workbench-bar__arrow {
  font-size: 30rpx;
}

/* 状态标签（从师傅端全局样式迁入） */
.status-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-pending {
  background: #FEF3C7;
  color: #D97706;
}

.status-confirmed {
  background: #DBEAFE;
  color: #1D4ED8;
}

.status-in-progress {
  background: #D1FAE5;
  color: #059669;
}

.status-pending-review {
  background: #FEF9C3;
  color: #A16207;
}

.status-negotiating {
  background: #FCE7F3;
  color: #BE185D;
}

.status-completed {
  background: #E0E7FF;
  color: #4F46E5;
}

.status-cancelled {
  background: #F3F4F6;
  color: #6B7280;
}
