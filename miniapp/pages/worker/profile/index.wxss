.section { margin: 24rpx 0; }
.actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 24rpx 0; }
.worker-head { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; }
.worker-head__avatar { width: 112rpx; height: 112rpx; border-radius: var(--radius-full); }
.worker-head__avatar--placeholder { display: flex; align-items: center; justify-content: center; background: var(--gradient-brand); }
.worker-head__name { flex: 1; font-size: 28rpx; color: var(--color-text-body); }
