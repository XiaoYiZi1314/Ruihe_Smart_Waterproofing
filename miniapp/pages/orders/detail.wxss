.status-head {
  padding: 32rpx 32rpx 8rpx;
}

.status-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.detail-block {
  padding: 12rpx 24rpx;
}

.master-box {
  margin-top: 16rpx;
  background: var(--color-master-bg);
  border-radius: var(--radius-md);
  padding: 16rpx 18rpx;
  color: var(--color-brand);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.scene-image {
  width: 188rpx;
  height: 188rpx;
  border-radius: var(--radius-md);
}

.remark-text {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}
/* ========== 第三阶段新增：评价展示 ========== */
.review-summary {
  margin-top: 16rpx;
}

.review-score-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.review-score-label {
  font-size: 25rpx;
  color: var(--color-text-secondary);
}

.review-stars {
  color: var(--color-orange, #F59E0B);
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.review-comment {
  margin-top: 16rpx;
  background: var(--color-bg, #F4F6FA);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  font-size: 25rpx;
  color: var(--color-text);
  line-height: 1.7;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.review-image {
  width: 188rpx;
  height: 188rpx;
  border-radius: var(--radius-md);
}

/* ========== 弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.modal {
  position: relative;
  z-index: 1;
  width: 620rpx;
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  padding: 40rpx 32rpx;
}

.modal--review {
  width: 660rpx;
  max-height: 88vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.modal__title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-text);
  text-align: center;
  margin-bottom: 16rpx;
}

.modal__tip {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 32rpx;
}

.modal__textarea {
  width: 100%;
  height: 200rpx;
  background: var(--color-bg, #F4F6FA);
  border: 2rpx solid #E5E7EB;
  border-radius: var(--radius-md);
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.modal__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal__actions rh-button {
  flex: 1;
}

/* ========== 评分星级 ========== */
.review-media {
  margin: 16rpx 0 8rpx;
}

.review-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.review-thumb {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
}

.review-thumb__img {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-md);
}

.review-thumb__del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 0 var(--radius-md) 0 var(--radius-md);
}

.review-thumb--add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
  background: var(--color-input-bg, #F8FAFD);
  border: 1rpx dashed var(--color-input-border, #E5E7EB);
  color: var(--color-text-muted, #9CA3AF);
  font-size: 22rpx;
}

.review-thumb__plus {
  font-size: 44rpx;
  line-height: 1;
}

.review-media__tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted, #9CA3AF);
}

.rate-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.rate-label {
  font-size: 27rpx;
  color: var(--color-text);
}

.rate-stars {
  display: flex;
  gap: 8rpx;
}

.rate-star {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  min-height: 72rpx;
  font-size: 44rpx;
  color: #D1D5DB;
}

.rate-star--on {
  color: var(--color-orange, #F59E0B);
}
