<view class="page-wrap page-pad">
  <rh-load-more wx:if="{{loading}}" loading />
  <block wx:elif="{{order}}">
    <view class="detail-section"><rh-status-tag status="{{order.status}}" /><rh-section-title title="{{order.service_name}}" /></view>
    <rh-info-row label="工单号" value="{{order.order_no}}" />
    <rh-info-row label="客户" value="{{order.contact_name || order.customer_name}}" />
    <rh-info-row label="电话" value="{{order.contact_phone}}" />
    <rh-info-row label="地址" value="{{order.full_address}}" />
    <view class="worker-actions"><rh-button variant="line" text="拨打客户" bind:tap="callCustomer" /><rh-button variant="ghost" text="复制地址" bind:tap="copyAddress" /></view>
    <view class="detail-section"><rh-section-title title="预约信息" /></view>
    <rh-info-row label="期望价格" value="{{order.expected_price}}" />
    <rh-info-row label="预计上门" value="{{order.estimatedTimeText}}" />
    <view class="rh-form-value">{{order.remark || '无备注'}}</view>
    <view class="image-grid"><image wx:for="{{order.images}}" wx:key="id" src="{{item.image_url}}" mode="aspectFill" data-url="{{item.image_url}}" bindtap="previewImage" /></view>
    <view class="detail-section"><rh-section-title title="费用明细" /></view>
    <rh-info-row label="上门费" value="{{order.door_fee}}" />
    <rh-info-row label="材料费" value="{{order.material_fee}}" />
    <rh-info-row label="工时费" value="{{order.labor_fee}}" />
    <rh-info-row label="合计" value="{{order.priceText}}" emphasize />
    <view class="detail-section"><rh-section-title title="时间记录" /></view>
    <rh-info-row label="下单时间" value="{{order.createdTimeText}}" />
    <rh-info-row label="指派时间" value="{{order.assignedTimeText}}" />
    <rh-info-row label="接单时间" value="{{order.acceptedTimeText}}" />
    <rh-info-row label="开始施工" value="{{order.startedTimeText}}" />
    <rh-info-row label="完工时间" value="{{order.completedTimeText}}" />
    <rh-info-row label="验收完成" value="{{order.finishedTimeText}}" />
  </block>
  <rh-empty wx:else text="工单不存在或暂时无法加载" />
  <rh-sticky-bar wx:if="{{order}}">
    <rh-button wx:if="{{order.canReject}}" variant="danger" text="拒绝" bind:tap="openRejectModal" disabled="{{submitting}}" />
    <rh-button wx:if="{{order.canAccept}}" text="接受工单" bind:tap="handleAccept" loading="{{submitting}}" />
    <rh-button wx:if="{{order.canStart}}" text="开始施工" bind:tap="handleStart" loading="{{submitting}}" />
    <rh-button wx:if="{{order.canComplete}}" text="完工填价" bind:tap="openCompleteModal" disabled="{{submitting}}" />
  </rh-sticky-bar>
  <view class="modal-mask" wx:if="{{showRejectModal || showCompleteModal}}">
    <view class="modal-content"><rh-card>
      <block wx:if="{{showRejectModal}}">
        <rh-section-title title="拒单理由" />
        <rh-form-field label="理由" required><textarea class="rh-input rh-input--area" value="{{rejectReason}}" maxlength="1000" bindinput="onRejectReasonInput" /></rh-form-field>
        <view class="worker-actions"><rh-button variant="ghost" text="取消" bind:tap="closeRejectModal" /><rh-button text="确认拒单" bind:tap="handleReject" loading="{{submitting}}" /></view>
      </block>
      <block wx:else>
        <rh-section-title title="完工填价" />
        <rh-form-field label="上门费" required><input class="rh-input" type="digit" value="{{doorFee}}" bindinput="onDoorFeeInput" /></rh-form-field>
        <rh-form-field label="材料费" required><input class="rh-input" type="digit" value="{{materialFee}}" bindinput="onMaterialFeeInput" /></rh-form-field>
        <rh-form-field label="工时费" required><input class="rh-input" type="digit" value="{{laborFee}}" bindinput="onLaborFeeInput" /></rh-form-field>
        <rh-info-row label="合计" value="{{totalFee}}" emphasize />
        <view class="worker-actions"><rh-button variant="ghost" text="取消" bind:tap="closeCompleteModal" /><rh-button text="确认完工" bind:tap="handleComplete" loading="{{submitting}}" /></view>
      </block>
    </rh-card></view>
  </view>
</view>
