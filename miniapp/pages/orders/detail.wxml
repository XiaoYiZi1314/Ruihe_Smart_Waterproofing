<view class="page-wrap page-wrap--footer">
  <rh-empty wx:if="{{!loading && !order && loadFailed}}" text="网络不佳，加载失败" action-text="重新加载" bind:action="onRetryLoad" />
  <view wx:if="{{!loading && order}}">
    <view class="status-head">
      <rh-status-tag status="{{statusMeta.tagClass}}" text="{{statusMeta.text}}" />
      <view class="status-desc">{{statusMeta.desc}}</view>
    </view>

    <view class="detail-block" wx:if="{{correctionNotice}}">
      <view class="notice-corrected">
        <text class="notice-corrected__title">费用已更正</text>
        <text class="notice-corrected__desc">{{correctionNotice}}</text>
      </view>
    </view>

    <view class="detail-block">
      <rh-card>
        <rh-section-title title="服务信息" />
        <rh-info-row label="工单号" value="{{order.order_no}}" />
        <rh-info-row label="服务项目" value="{{order.service_name}}" />
        <rh-info-row wx:if="{{appointmentText}}" label="预约时间" value="{{appointmentText}}" />
        <rh-info-row wx:if="{{estimatedTimeText}}" label="预计上门" value="{{estimatedTimeText}}" />
        <rh-info-row wx:if="{{order.expected_price}}" label="期望价格" value="{{expectedPriceText}}" emphasize />
        <rh-info-row wx:if="{{order.final_price}}" label="最终价格" value="{{finalPriceText}}" emphasize />
      </rh-card>
    </view>

    <!-- 费用明细 -->
    <view class="detail-block" wx:if="{{order.final_price}}">
      <rh-card>
        <rh-section-title title="费用明细" />
        <rh-info-row wx:if="{{doorFeeText}}" label="上门费" value="{{doorFeeText}}" />
        <rh-info-row wx:if="{{materialFeeText}}" label="材料费" value="{{materialFeeText}}" />
        <rh-info-row wx:if="{{laborFeeText}}" label="工时费" value="{{laborFeeText}}" />
        <rh-info-row label="合计" value="{{finalPriceText}}" emphasize />
      </rh-card>
    </view>

    <view class="detail-block">
      <rh-card>
        <rh-section-title title="联系信息" />
        <rh-info-row label="联系人" value="{{order.contact_name}}" />
        <rh-info-row label="联系电话" value="{{order.contact_phone}}" />
        <rh-info-row label="服务地址" value="{{order.full_address}}" />
      </rh-card>
    </view>

    <view class="detail-block" wx:if="{{order.worker_name}}">
      <rh-card>
        <rh-section-title title="施工师傅" />
        <view class="master-box">
          <rh-icon name="user" tone="brand" size="28" />
          <text>分配师傅：{{order.worker_name}} {{maskedWorkerPhone}}</text>
        </view>
      </rh-card>
    </view>

    <view class="detail-block" wx:if="{{order.images && order.images.length > 0}}">
      <rh-card>
        <rh-section-title title="现场图片" />
        <view class="images-grid">
          <rh-image
            wx:for="{{order.images}}"
            wx:key="key"
            class="scene-image"
            src="{{item.image_url}}"
            bindtap="onPreviewImage"
            bind:error="onImageError"
            bind:retry="onRetryImages"
            data-url="{{item.image_url}}"
          />
        </view>
        <rh-button wx:if="{{imageLoadFailed}}" variant="line" block text="图片加载失败，点击重试" bind:tap="onRetryImages" />
      </rh-card>
    </view>

    <view class="detail-block" wx:if="{{order.remark}}">
      <rh-card>
        <rh-section-title title="备注说明" />
        <view class="remark-text">{{order.remark}}</view>
      </rh-card>
    </view>

    <!-- 评价展示 -->
    <view class="detail-block" wx:if="{{order.review}}">
      <rh-card>
        <rh-section-title title="我的评价" />
        <view class="review-summary">
          <view class="review-score-row">
            <text class="review-score-label">服务态度</text>
            <text class="review-stars">{{order.review.service_attitude_score >= 1 ? '★' : '☆'}}{{order.review.service_attitude_score >= 2 ? '★' : '☆'}}{{order.review.service_attitude_score >= 3 ? '★' : '☆'}}{{order.review.service_attitude_score >= 4 ? '★' : '☆'}}{{order.review.service_attitude_score >= 5 ? '★' : '☆'}}</text>
          </view>
          <view class="review-score-row">
            <text class="review-score-label">施工质量</text>
            <text class="review-stars">{{order.review.quality_score >= 1 ? '★' : '☆'}}{{order.review.quality_score >= 2 ? '★' : '☆'}}{{order.review.quality_score >= 3 ? '★' : '☆'}}{{order.review.quality_score >= 4 ? '★' : '☆'}}{{order.review.quality_score >= 5 ? '★' : '☆'}}</text>
          </view>
          <view class="review-score-row">
            <text class="review-score-label">价格满意度</text>
            <text class="review-stars">{{order.review.price_score >= 1 ? '★' : '☆'}}{{order.review.price_score >= 2 ? '★' : '☆'}}{{order.review.price_score >= 3 ? '★' : '☆'}}{{order.review.price_score >= 4 ? '★' : '☆'}}{{order.review.price_score >= 5 ? '★' : '☆'}}</text>
          </view>
          <view class="review-comment">{{order.review.comment}}</view>
          <video wx:if="{{order.review.video_url}}" src="{{order.review.video_url}}" style="width:100%;height:360rpx" />
          <view class="review-images" wx:if="{{order.review.images.length}}">
            <rh-image
              wx:for="{{order.review.images}}"
              wx:key="key"
              class="review-image"
              src="{{item.image_url}}"
              data-url="{{item.image_url}}"
              bindtap="onPreviewReviewImage"
            />
          </view>
          <rh-button variant="danger" text="删除评价" bind:tap="deleteReview" />
        </view>
      </rh-card>
    </view>

    <view class="detail-block">
      <rh-card>
        <rh-section-title title="订单进度" />
        <rh-timeline items="{{timelineItems}}" />
      </rh-card>
    </view>
  </view>

  <rh-load-more wx:if="{{loading}}" loading />

  <!-- 底部操作栏：根据状态渲染 -->
  <rh-sticky-bar wx:if="{{!loading && order}}">
    <!-- 取消工单 -->
    <rh-button
      wx:if="{{order.status === 'pending' || order.status === 'confirmed'}}"
      variant="danger"
      size="lg"
      text="取消预约"
      bind:tap="onCancelOrder"
    />

    <!-- 催单 -->
    <rh-button
      wx:if="{{order.status === 'pending' || order.status === 'confirmed'}}"
      variant="line"
      size="lg"
      text="{{order.urge_count ? '催单(' + order.urge_count + ')' : '催单'}}"
      bind:tap="onUrgeOrder"
    />

    <!-- 联系师傅 -->
    <rh-button
      wx:if="{{order.worker_phone && order.status !== 'pending' && order.status !== 'cancelled'}}"
      variant="line"
      size="lg"
      text="联系师傅"
      bind:tap="onCallMaster"
    />

    <!-- 确认验收 / 价格异议 -->
    <rh-button
      wx:if="{{order.status === 'pending_review' || order.status === 'waiting_acceptance'}}"
      variant="brand"
      size="lg"
      text="确认验收"
      bind:tap="onConfirmOrder"
    />
    <rh-button
      wx:if="{{order.status === 'pending_review' && !order.price_adjusted_at}}"
      variant="line"
      size="lg"
      text="价格异议"
      bind:tap="openDisputeModal"
    />

    <!-- 评价 -->
    <rh-button
      wx:if="{{order.status === 'completed' && !order.review_submitted_at}}"
      variant="brand"
      size="lg"
      text="评价服务"
      bind:tap="openReviewModal"
    />

    <!-- 重新预约 -->
    <rh-button
      wx:if="{{order.status === 'cancelled' || (order.status === 'completed' && order.review)}}"
      variant="brand"
      size="lg"
      text="重新预约"
      bind:tap="onRebook"
    />

    <!-- 无具体操作时兜底：联系客服 -->
    <rh-button
      wx:if="{{order.status === 'price_negotiating' || order.status === 'negotiating'}}"
      variant="line"
      size="lg"
      text="联系客服"
      bind:tap="onCallService"
    />
  </rh-sticky-bar>

  <!-- 价格异议弹窗 -->
  <view class="modal-mask" wx:if="{{showDisputeModal}}">
    <view class="modal-backdrop" bindtap="closeDisputeModal"></view>
    <view class="modal">
      <view class="modal__title">价格异议</view>
      <view class="modal__tip">请描述您对价格的具体异议，管理员将尽快与您协商处理</view>
      <textarea
        class="modal__textarea"
        placeholder="例如：材料费偏高，与预期不符..."
        value="{{disputeReason}}"
        maxlength="200"
        bindinput="onDisputeReasonInput"
      ></textarea>
      <view class="modal__actions">
        <rh-button variant="ghost" size="md" text="取消" bind:tap="closeDisputeModal" />
        <rh-button variant="brand" size="md" text="提交异议" loading="{{submitting}}" bind:tap="submitDispute" />
      </view>
    </view>
  </view>

  <!-- 评价弹窗 -->
  <view class="modal-mask" wx:if="{{showReviewModal}}">
    <view class="modal-backdrop" bindtap="closeReviewModal"></view>
    <view class="modal modal--review">
      <view class="modal__title">评价服务</view>
      <rh-button variant="line" text="选择视频" bind:tap="chooseReviewVideo" />
      <video wx:if="{{reviewVideo}}" src="{{reviewVideo}}" style="width:100%;height:280rpx" />
      <rh-button wx:if="{{reviewVideo}}" variant="ghost" text="移除视频" bind:tap="removeReviewVideo" />

      <view class="review-media">
        <view class="review-thumbs">
          <view class="review-thumb" wx:for="{{reviewImages}}" wx:key="*this">
            <rh-image class="review-thumb__img" src="{{item}}" data-url="{{item}}" bindtap="previewReviewDraftImage" />
            <view class="review-thumb__del" catchtap="removeReviewImage" data-index="{{index}}">×</view>
          </view>
          <view class="review-thumb review-thumb--add" wx:if="{{reviewImages.length < maxReviewImages}}" bindtap="chooseReviewImages">
            <text class="review-thumb__plus">+</text>
            <text>添加图片</text>
          </view>
        </view>
        <view class="review-media__tip">图片最多 {{maxReviewImages}} 张，可与视频同时提交</view>
      </view>

      <view class="rate-row">
        <text class="rate-label">服务态度</text>
        <view class="rate-stars">
          <view
            wx:for="{{starRange}}"
            wx:key="*this"
            class="rate-star {{reviewScores.attitude >= item ? 'rate-star--on' : ''}}"
            data-type="attitude"
            data-score="{{item}}"
            bindtap="onScoreTap"
          >★</view>
        </view>
      </view>

      <view class="rate-row">
        <text class="rate-label">施工质量</text>
        <view class="rate-stars">
          <view
            wx:for="{{starRange}}"
            wx:key="*this"
            class="rate-star {{reviewScores.quality >= item ? 'rate-star--on' : ''}}"
            data-type="quality"
            data-score="{{item}}"
            bindtap="onScoreTap"
          >★</view>
        </view>
      </view>

      <view class="rate-row">
        <text class="rate-label">价格满意度</text>
        <view class="rate-stars">
          <view
            wx:for="{{starRange}}"
            wx:key="*this"
            class="rate-star {{reviewScores.price >= item ? 'rate-star--on' : ''}}"
            data-type="price"
            data-score="{{item}}"
            bindtap="onScoreTap"
          >★</view>
        </view>
      </view>

      <textarea
        class="modal__textarea"
        placeholder="说说您对本次服务的评价..."
        value="{{reviewComment}}"
        maxlength="200"
        bindinput="onReviewCommentInput"
      ></textarea>

      <view class="modal__actions">
        <rh-button variant="ghost" size="md" text="取消" bind:tap="closeReviewModal" />
        <rh-button variant="brand" size="md" text="提交评价" loading="{{submitting}}" bind:tap="submitReview" />
      </view>
    </view>
  </view>
</view>
