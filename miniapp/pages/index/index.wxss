.container {
  min-height: 100vh;
  background: #111827;
  padding-bottom: 40rpx;
}

/* 轮播图 */
.banner-swiper {
  width: 100%;
  height: 400rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 通用section样式 */
.section {
  margin: 32rpx 24rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #F8FAFC;
  margin-bottom: 8rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #64748B;
  letter-spacing: 2rpx;
}

/* 服务网格 */
.services-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.service-card {
  background: #1E293B;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #334155;
  transition: all 0.3s ease;
}

.service-image {
  width: 100%;
  height: 200rpx;
}

.service-info {
  padding: 20rpx;
}

.service-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #F8FAFC;
  margin-bottom: 8rpx;
}

.service-desc {
  display: block;
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 16rpx;
}

.service-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.service-price {
  font-size: 26rpx;
  font-weight: 600;
  color: #38BDF8;
}

.service-action {
  font-size: 22rpx;
  color: #64748B;
  padding: 8rpx 16rpx;
  background: rgba(56, 189, 248, 0.1);
  border-radius: 8rpx;
}

/* 联系卡片 */
.contact-card {
  background: #1E293B;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #334155;
}

.contact-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.contact-item:last-child {
  margin-bottom: 0;
}

.contact-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.contact-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.contact-label {
  font-size: 24rpx;
  color: #64748B;
  margin-bottom: 8rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #F8FAFC;
  line-height: 1.6;
}

.contact-value.link {
  color: #38BDF8;
}

/* 关于我们卡片 */
.about-card {
  background: #1E293B;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #334155;
}

.about-text {
  font-size: 28rpx;
  color: #CBD5E1;
  line-height: 1.8;
  text-indent: 2em;
}

/* 加盟卡片 */
.join-card {
  background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #334155;
}

.join-desc {
  display: block;
  font-size: 28rpx;
  color: #F8FAFC;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.join-benefits {
  margin-bottom: 24rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.benefit-dot {
  color: #38BDF8;
  margin-right: 12rpx;
  font-size: 20rpx;
}

.benefit-text {
  font-size: 26rpx;
  color: #CBD5E1;
}

.join-phone {
  padding-top: 24rpx;
  border-top: 1rpx solid #334155;
  font-size: 28rpx;
  color: #94A3B8;
}

.phone-number {
  color: #38BDF8;
  font-weight: 600;
}

/* 底部留白 */
.footer-spacer {
  height: 40rpx;
}
