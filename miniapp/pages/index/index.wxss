.home-carousel {
  height: 320rpx;
  margin: 24rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-2);
}

.home-slide {
  width: 100%;
  height: 100%;
  position: relative;
}

.home-slide__img {
  width: 100%;
  height: 100%;
}

.home-slide__mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx 32rpx 40rpx;
  color: #ffffff;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.5) 100%);
}

.home-slide__title {
  font-size: 32rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.home-slide__sub {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.home-list {
  margin-top: 20rpx;
}

.home-block {
  padding: 8rpx 24rpx 12rpx;
}

.home-card-gap {
  height: 12rpx;
}

.about-text {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  white-space: pre-line;
}

.about-more {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-brand);
}

.join-columns {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  margin-top: 16rpx;
}

.join-partners {
  flex: 1 1 0;
  min-width: 0;
  white-space: pre-line;
  overflow-wrap: anywhere;
}

.join-contact {
  flex: 1 1 0;
  min-width: 0;
}