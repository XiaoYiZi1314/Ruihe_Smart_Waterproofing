.rh-menu {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
  background: #ffffff;
  border-top: 1rpx solid var(--color-divider);
}

.rh-menu:first-child {
  border-top: none;
}

.rh-menu--active {
  background: var(--color-menu-active);
}

.rh-menu__ico {
  width: 60rpx;
  height: 60rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rh-menu__txt {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text);
}

.rh-menu__badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--color-red);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}