.login-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  padding: 80rpx 48rpx 80rpx;
  box-sizing: border-box;
}

.login-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.login-logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-brand-light));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-brand);
  margin-bottom: 32rpx;
}

.login-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text);
}

.login-slogan {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.login-panel {
  padding-bottom: 40rpx;
}

.login-tips {
  text-align: center;
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
}