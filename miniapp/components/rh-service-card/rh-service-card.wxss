.rh-svc {
  margin: 0 24rpx 24rpx;
  display: flex;
  gap: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  padding: 24rpx;
  box-shadow: var(--shadow);
}

.rh-svc--active {
  transform: scale(0.985);
  box-shadow: var(--shadow-2);
}

.rh-svc__cover {
  width: 168rpx;
  height: 168rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.rh-svc__cover--grad {
  display: flex;
  align-items: center;
  justify-content: center;
}

.rh-svc__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.rh-svc__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.rh-svc__desc {
  font-size: 25rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rh-svc__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
}

.rh-svc__price {
  flex: 1 1 0;
  min-width: 0;
  overflow-wrap: anywhere;
  color: var(--color-red);
  font-size: 28rpx;
  font-weight: 700;
}

.rh-svc__unit {
  display: block;
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 4rpx;
}