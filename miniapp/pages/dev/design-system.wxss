.ds-page {
  padding-bottom: 48rpx;
}

.ds-hero {
  margin: 24rpx;
  padding: 18rpx 24rpx;
  background: var(--color-brand-soft);
  color: var(--color-brand);
  border-radius: var(--radius-md);
  font-size: 23rpx;
}

.ds-sec {
  margin: 28rpx 0 8rpx;
  padding: 0 24rpx;
}

.ds-colors {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.ds-color {
  width: 160rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.ds-swatch {
  height: 72rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  box-shadow: var(--shadow);
}

.ds-code {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.ds-font {
  margin-top: 16rpx;
  color: var(--color-text);
}

.ds-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
  align-items: center;
}

.ds-gap {
  height: 20rpx;
}