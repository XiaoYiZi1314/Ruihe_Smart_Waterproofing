<view class="page-wrap page-wrap--footer">
  <view wx:if="{{!loading && service}}">
    <!-- 图片轮播 -->
    <view class="detail-banner">
      <swiper 
        wx:if="{{bannerImages.length > 0}}"
        class="banner-swiper" 
        indicator-dots 
        indicator-color="rgba(255,255,255,0.5)"
        indicator-active-color="#ffffff"
        autoplay
        interval="5000"
        circular
        bindchange="onBannerChange"
      >
        <swiper-item wx:for="{{bannerImages}}" wx:key="*this">
          <rh-image
            class="banner-image"
            src="{{item}}"
            bindtap="onPreviewImage"
            data-url="{{item}}"
          />
        </swiper-item>
      </swiper>
      <view wx:else class="banner-placeholder" style="background: {{bannerGradient}};">
        <rh-icon name="shield" tone="white" size="120" />
      </view>
      <view class="banner-title">{{service.name}}</view>
      <view wx:if="{{bannerImages.length > 0}}" class="banner-indicator">{{currentBannerIndex + 1}} / {{bannerImages.length}}</view>
    </view>

    <view class="detail-price">
      {{priceMain}}
      <text class="detail-price__unit">{{priceSuffix || '参考价格'}}</text>
    </view>

    <view class="detail-sec" wx:if="{{highlights.length}}">
      <rh-section-title title="服务亮点" />
      <view class="detail-tags">
        <text wx:for="{{highlights}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="detail-sec">
      <rh-section-title title="服务介绍" />
      <rich-text class="detail-richtext" nodes="{{service.description || '专业防水施工，免费上门勘测，签约质保。'}}" />
    </view>

    <view class="detail-sec">
      <rh-section-title title="服务流程" />
      <view class="detail-p">① 在线预约 → ② 上门勘测 → ③ 方案确认 → ④ 施工作业 → ⑤ 验收质保</view>
    </view>

    <view class="detail-sec">
      <rh-section-title title="用户评价" />

      <!-- 评价统计 -->
      <view class="review-stats" wx:if="{{reviewStats}}">
        <view class="review-stats__overall">
          <text class="review-stats__score">{{reviewStats.avg_overall}}</text>
          <text class="review-stats__label">综合评分</text>
        </view>
        <view class="review-stats__detail">
          <view class="review-stats__row">
            <text class="review-stats__name">服务态度</text>
            <text class="review-stats__value">{{reviewStats.avg_attitude}}</text>
          </view>
          <view class="review-stats__row">
            <text class="review-stats__name">施工质量</text>
            <text class="review-stats__value">{{reviewStats.avg_quality}}</text>
          </view>
          <view class="review-stats__row">
            <text class="review-stats__name">收费合理</text>
            <text class="review-stats__value">{{reviewStats.avg_price}}</text>
          </view>
          <view class="review-stats__count">共 {{reviewStats.total}} 条评价</view>
        </view>
      </view>

      <!-- 评价列表 -->
      <view class="review-item" wx:for="{{reviews}}" wx:key="id">
        <view class="review-item__header">
          <text class="review-item__name">{{item.maskedName}}</text>
          <text class="review-item__stars">{{item.avgScore}} 分</text>
        </view>
        <view class="review-item__score-row">
          <text>态度 {{item.service_attitude_score}}</text>
          <text>质量 {{item.quality_score}}</text>
          <text>价格 {{item.price_score}}</text>
        </view>
        <view class="review-item__comment">{{item.comment}}</view>
        <view class="review-item__images" wx:if="{{item.images.length}}">
          <rh-image
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:for-index="imgIndex"
            wx:key="key"
            class="review-item__image"
            src="{{img.image_url}}"
            data-review="{{index}}"
            data-url="{{img.image_url}}"
            bindtap="onPreviewReviewImage"
          />
        </view>
        <video wx:if="{{item.video_url}}" src="{{item.video_url}}" style="width:100%;height:360rpx" />
        <view class="review-item__time">{{item.dateText}}</view>
      </view>

      <rh-empty wx:if="{{!reviews || reviews.length === 0}}" text="暂无评价，预约后来评价一下吧" />
    </view>
  </view>

  <!-- 骨架屏：与正式内容同布局，避免“空白 → 整页替换”的闪烁 -->
  <view wx:if="{{loading}}" class="sk">
    <view class="sk__banner sk__shimmer"></view>
    <view class="sk__price sk__shimmer"></view>
    <view class="sk__line sk__shimmer"></view>
    <view class="sk__line sk__line--short sk__shimmer"></view>
    <view class="sk__line sk__shimmer"></view>
  </view>

  <rh-empty wx:if="{{!loading && !service && loadFailed}}" text="{{loadErrorText}}" action-text="重新加载" bind:action="onRetryLoad" />

  <rh-sticky-bar wx:if="{{!loading && service}}">
    <rh-button variant="line" size="lg" text="咨询客服" bind:tap="onConsult" />
    <rh-button variant="brand" size="lg" block text="立即预约" bind:tap="onBook" />
  </rh-sticky-bar>
</view>