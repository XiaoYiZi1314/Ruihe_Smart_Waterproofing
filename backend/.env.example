# 服务器配置
PORT=3000
NODE_ENV=development
# Production binds loopback; expose through HTTPS reverse proxy only.
HOST=127.0.0.1
PUBLIC_ORIGIN=https://ruihezhihui.cn

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=waterproof_system
DB_USER=waterproof_user
DB_PASSWORD=strong_password_here

# 微信小程序配置
WECHAT_APPID=your_appid_here
WECHAT_SECRET=your_secret_here

# JWT配置
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# 微信订阅消息模板ID（在微信公众平台申请后填入）
# 未配置时通知会记录到 notifications 表但发送失败，不影响主流程
WECHAT_TEMPLATE_NEW_ORDER=
WECHAT_TEMPLATE_WORKER_ASSIGNED=
WECHAT_TEMPLATE_CUSTOMER_ASSIGNED=
WECHAT_TEMPLATE_ORDER_REJECTED=
WECHAT_TEMPLATE_WORK_STARTED=
WECHAT_TEMPLATE_WORK_COMPLETED=
WECHAT_TEMPLATE_ORDER_URGED=
WECHAT_TEMPLATE_ORDER_CONFIRMED=
WECHAT_TEMPLATE_ORDER_CANCELLED=
WECHAT_TEMPLATE_PRICE_ADJUSTED=
WECHAT_TEMPLATE_ORDER_AUTO_COMPLETED=

# Redis配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
