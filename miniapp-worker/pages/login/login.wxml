<view class="login-container">
  <view class="login-header">
    <view class="logo-circle">
      <text class="logo-text">瑞和</text>
    </view>
    <text class="title">瑞和防水师傅端</text>
    <text class="subtitle">专业防水堵漏服务平台</text>
  </view>

  <view class="login-form">
    <!-- 手机号密码登录 -->
    <block wx:if="{{loginMode === 'phone'}}">
      <view class="input-group">
        <input
          class="form-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>
      <view class="input-group">
        <input
          class="form-input"
          password
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>
      <button
        class="btn-wx-login"
        bindtap="handlePhoneLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        登 录
      </button>
      <view class="mode-switch" bindtap="switchMode">
        <text>使用微信授权登录</text>
      </view>
    </block>

    <!-- 微信授权登录 -->
    <block wx:else>
      <button
        class="btn-wx-login"
        bindtap="handleWxLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        微信授权登录
      </button>
      <view class="mode-switch" bindtap="switchMode">
        <text>使用手机号密码登录</text>
      </view>
    </block>

    <view class="login-tip">
      <text>仅限已开通师傅权限的账号登录</text>
      <text>如需开通请联系管理员</text>
    </view>
  </view>

  <view class="login-footer">
    <text class="footer-text">登录即代表同意《服务协议》和《隐私政策》</text>
  </view>
</view>
