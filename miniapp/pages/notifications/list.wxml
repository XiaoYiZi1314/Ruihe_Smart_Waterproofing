<view class="page-wrap page-pad">
  <view wx:if="{{unreadCount > 0}}" class="msg-toolbar">
    <text class="msg-toolbar__text">{{unreadCount}} 条未读</text>
    <text class="msg-toolbar__action" bindtap="markAllRead">全部已读</text>
  </view>

  <rh-load-more wx:if="{{loading}}" loading />
  <rh-empty wx:elif="{{loadFailed && items.length === 0}}" text="网络不佳，加载失败" action-text="重新加载" bind:action="onRetryLoad" />
  <rh-empty wx:elif="{{items.length === 0}}" text="暂无消息" />

  <view
    class="message"
    wx:for="{{items}}"
    wx:key="id"
    data-id="{{item.id}}"
    data-order-id="{{item.order_id}}"
    bindtap="openMessage"
  >
    <rh-card>
      <view class="msg-head">
        <view wx:if="{{!item.is_read}}" class="msg-dot"></view>
        <rh-section-title title="{{item.title}}" />
      </view>
      <view class="rh-form-value">{{item.content}}</view>
      <rh-info-row wx:if="{{item.order_no}}" label="工单号" value="{{item.order_no}}" />
      <rh-info-row wx:if="{{item.service_name}}" label="服务" value="{{item.service_name}}" />
      <rh-info-row label="时间" value="{{item.timeText}}" />
      <view wx:if="{{item.order_id}}" class="msg-link">查看工单 ›</view>
    </rh-card>
  </view>
</view>
