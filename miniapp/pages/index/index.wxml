<view class="page-wrap">
  <swiper
    wx:if="{{banners.length}}"
    class="home-carousel"
    indicator-dots
    indicator-color="rgba(255,255,255,0.5)"
    indicator-active-color="#ffffff"
    autoplay
    circular
    interval="3500"
  >
    <swiper-item
      wx:for="{{banners}}"
      wx:key="id"
      bindtap="onBannerTap"
      data-banner="{{item}}"
    >
      <view class="home-slide" style="background: {{item.gradient}};">
        <image wx:if="{{item.image_url}}" class="home-slide__img" src="{{item.image_url}}" mode="aspectFill" />
        <view class="home-slide__mask">
          <view class="home-slide__title">{{item.title}}</view>
          <view class="home-slide__sub">{{item.subtitle}}</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <rh-search-bar
    value="{{keyword}}"
    bind:input="onSearchInput"
    bind:confirm="onSearchConfirm"
  />

  <rh-quick-entry bind:tap="onQuickTap" />

  <rh-tag-bar
    items="{{categoryTags}}"
    active-key="{{currentCategoryId}}"
    bind:change="onCategoryChange"
  />

  <view class="page-pad">
    <rh-section-title title="🔥 热门服务" more="查看更多 ›" bind:more="onViewMoreServices" />
  </view>
  <view class="home-list">
    <rh-service-card
      wx:for="{{services}}"
      wx:key="id"
      service="{{item}}"
      bind:tap="onServiceTap"
      bind:book="onBookTap"
    />
    <rh-empty wx:if="{{!loading && loadFailed && allServices.length === 0}}" text="网络不佳，加载失败" action-text="重新加载" bind:action="onRetryLoad" />
    <rh-empty wx:elif="{{!loading && services.length === 0}}" text="暂无热门服务" />
  </view>

  <view class="home-block" wx:if="{{contact.phone || contact.mobile || contact.address}}">
    <rh-card>
      <rh-section-title title="📞 联系我们" />
      <view class="home-card-gap"></view>
      <rh-contact-line
        wx:if="{{contact.mobile || contact.phone}}"
        icon="phone"
        title="{{contact.mobile || contact.phone}}"
        subtitle="点击拨打客服电话"
        bind:tap="onCallPhone"
      />
      <rh-contact-line
        wx:if="{{contact.address}}"
        icon="location"
        title="{{contact.address}}"
        subtitle="服务联系地址"
      />
      <rh-contact-line
        wx:if="{{contact.wechat}}"
        icon="chat"
        title="{{contact.wechat}}"
        subtitle="点击复制微信号"
        bind:tap="onCopyWechat"
      />
      <rh-contact-line
        wx:if="{{contact.hours}}"
        icon="clock"
        title="{{contact.hours}}"
        subtitle="营业时间"
      />
    </rh-card>
  </view>

  <view class="home-block" id="about" wx:if="{{aboutUs}}">
    <rh-card>
      <rh-section-title title="🏢 关于我们" />
      <view class="about-text">{{aboutUs}}</view>
      <view class="about-more" bindtap="goAbout">查看详情 ›</view>
    </rh-card>
  </view>

  <view class="home-block" wx:if="{{joinInfo.phone || joinInfo.partners || joinInfo.description}}">
    <rh-card>
      <rh-section-title title="🤝 加盟合作" />
      <view class="join-columns">
        <view class="join-partners" wx:if="{{joinInfo.partners}}">
          <rh-contact-line icon="shield" title="合作品牌 / 公司" subtitle="{{joinInfo.partners}}" />
        </view>
        <view class="join-contact" wx:if="{{joinInfo.phone}}">
          <rh-contact-line icon="phone" title="加盟热线" subtitle="{{joinInfo.phone}}" bind:tap="onJoinConsult" />
        </view>
      </view>
      <view class="about-text" wx:if="{{joinInfo.description}}">{{joinInfo.description}}</view>
    </rh-card>
  </view>
</view>