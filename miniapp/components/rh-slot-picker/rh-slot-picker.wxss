.rh-slots {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.rh-slot {
  font-size: 26rpx;
  padding: 14rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-slot-bg);
  color: var(--color-text-secondary);
}

.rh-slot.is-on {
  background: var(--color-brand);
  color: #ffffff;
}