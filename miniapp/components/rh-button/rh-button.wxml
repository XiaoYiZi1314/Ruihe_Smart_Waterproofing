<button
  class="rh-btn rh-btn--{{variant}} rh-btn--{{size}} {{block ? 'rh-btn--block' : ''}} {{disabled || loading ? 'is-disabled' : ''}}"
  hover-class="rh-btn--active"
  disabled="{{disabled || loading}}"
  bindtap="onTap"
>
  <text wx:if="{{loading}}">{{text || '处理中...'}}</text>
  <text wx:elif="{{text}}">{{text}}</text>
  <slot wx:else></slot>
</button>