.rh-search {
  height: 72rpx;
  margin: 0 24rpx 24rpx;
  padding: 0 28rpx;
  background: var(--color-surface);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.rh-search__input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: var(--color-text);
  background: transparent;
}

.rh-search__ph {
  color: var(--color-text-muted);
}

.rh-search--flush {
  margin-left: 0;
  margin-right: 0;
}