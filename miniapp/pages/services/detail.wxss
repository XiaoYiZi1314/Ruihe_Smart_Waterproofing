.detail-banner {
  height: 400rpx;
  position: relative;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-indicator {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 28rpx;
}

.detail-price {
  font-size: 40rpx;
  color: var(--color-red);
  font-weight: 700;
  margin: 28rpx 32rpx 8rpx;
}

.detail-price__unit {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-weight: 400;
  margin-left: 8rpx;
}

.detail-sec {
  padding: 24rpx 32rpx;
}

.detail-p {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.detail-richtext {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.detail-tags {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.detail-tags text {
  font-size: 22rpx;
  background: var(--color-brand-soft);
  color: var(--color-brand);
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
}
/* ========== 用户评价 ========== */
.review-stats {
  display: flex;
  align-items: center;
  background: var(--color-bg, #F4F6FA);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-top: 16rpx;
}

.review-stats__overall {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-right: 32rpx;
  border-right: 1rpx solid #E5E7EB;
}

.review-stats__score {
  font-size: 56rpx;
  font-weight: bold;
  color: var(--color-orange, #F59E0B);
  line-height: 1.1;
}

.review-stats__label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.review-stats__detail {
  flex: 1;
  padding-left: 32rpx;
}

.review-stats__row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  padding: 4rpx 0;
}

.review-stats__name {
  color: var(--color-text-secondary);
}

.review-stats__value {
  color: var(--color-orange, #F59E0B);
  font-weight: 500;
}

.review-stats__count {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

.review-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.review-item:last-child {
  border-bottom: none;
}

.review-item__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.review-item__name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text);
}

.review-item__stars {
  font-size: 24rpx;
  color: var(--color-orange, #F59E0B);
  font-weight: 500;
}

.review-item__score-row {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}

.review-item__score-row text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg, #F4F6FA);
  border-radius: var(--radius-pill, 36rpx);
  padding: 4rpx 16rpx;
}

.review-item__comment {
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.7;
  margin-top: 16rpx;
}

.review-item__time {
  font-size: 22rpx;
  color: #D1D5DB;
  margin-top: 12rpx;
}
