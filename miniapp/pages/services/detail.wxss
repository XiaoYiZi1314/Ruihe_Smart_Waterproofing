.detail-banner {
  height: 360rpx;
  position: relative;
  color: #ffffff;
}

.detail-banner__img {
  width: 100%;
  height: 100%;
}

.detail-banner__mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 36rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(11, 18, 32, 0.4) 100%);
}

.detail-banner__title {
  font-size: 36rpx;
  font-weight: 700;
}

.detail-price {
  font-size: 40rpx;
  color: var(--color-red);
  font-weight: 700;
  margin: 28rpx 32rpx 8rpx;
}

.detail-price__unit {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-weight: 400;
  margin-left: 8rpx;
}

.detail-sec {
  padding: 12rpx 32rpx 28rpx;
}

.detail-h {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--color-text);
}

.detail-p {
  font-size: 25rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.detail-tags {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.detail-tags text {
  font-size: 22rpx;
  background: var(--color-brand-soft);
  color: var(--color-brand);
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
}